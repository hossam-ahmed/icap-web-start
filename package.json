{
  "name": "icap-web-start",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run generate-icons\" \"npm run watch-palette\" \"vite\"",
    "mock": "concurrently \"npm run generate-icons\" \"npm run watch-palette\" \"nodemon mock-server/index.ts\" \"vite --mode mock\"",
    "mock-server": "nodemon mock-server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "watch-palette": "sass --watch src/assets/styles/sources/palette.scss:src/assets/styles/sources/palette.css",
    "generate-icons": "ts-node tools/generate-icons.ts"
  },
  "dependencies": {
    "@tailwindcss/language-server": "^0.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "lodash": "^4.17.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.2",
    "sass-loader": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.20",
    "@types/lodash": "^4.14.194",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "nodemon": "3.1.14",
    "oxlint": "^1.71.0",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
